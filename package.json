{
  "name": "3d-showcase",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm --filter @showcase/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "generate:assets": "node scripts/generate-astra-concept.mjs",
    "validate:assets": "pnpm generate:assets && node scripts/validate-showcase-assets.mjs",
    "lint": "pnpm -r --if-present lint"
  }
}
